// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum BookingStatus {
  REQUESTED // waiting for technician
  ACCEPTED // awaiting payment
  DECLINED
  PAID
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum ReviewTarget {
  SERVICE
  TECHNICIAN
}

enum ServiceTag {
  MOST_BOOKED
  TOP_RATED
  EMERGENCY
}

// ─────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  initials     String?
  profileImage String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  technicianProfile TechnicianProfile?
  bookings          Booking[]            @relation("CustomerBookings")
  reviews           Review[]             @relation("ReviewAuthor")
  payments          Payment[]
  resetTokens       PasswordResetToken[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String? // emoji e.g. "🔧"
  isVisible Boolean  @default(true) // show on customer cards / search
  sortOrder Int      @default(0)
  jobsDone  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services             Service[]
  technicianCategories TechnicianCategory[]

  @@index([isVisible])
  @@map("categories")
}

model Area {
  id   String @id @default(cuid())
  name String @unique // Dhanmondi, Gulshan, …

  technicians TechnicianProfile[]

  @@index([name])
  @@map("areas")
}

model Service {
  id          String      @id @default(cuid())
  categoryId  String
  title       String
  description String
  price       Int // starting ৳
  duration    String // "45 min" | "1.5 hrs"
  ratingAvg   Float       @default(0)
  reviewCount Int         @default(0)
  tag         ServiceTag?
  isFeatured  Boolean     @default(false)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category Category  @relation(fields: [categoryId], references: [id])
  bookings Booking[]
  reviews  Review[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([price])
  @@index([ratingAvg])
  @@map("services")
}

// ─────────────────────────────────────────────
// Technicians
// ─────────────────────────────────────────────

model TechnicianProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  trade         String
  areaId        String?
  bio           String?
  initials      String
  visitFee      Int // ৳ / visit
  experienceYrs Int      @default(0)
  jobsCompleted Int      @default(0)
  ratingAvg     Float    @default(0)
  reviewCount   Int      @default(0)
  online        Boolean  @default(false)
  verified      Boolean  @default(false)
  coverKm       Int      @default(4)
  replyMins     Int      @default(8)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       Area?                @relation(fields: [areaId], references: [id])
  categories TechnicianCategory[]
  skills     TechnicianSkill[]
  slots      AvailabilitySlot[]
  bookings   Booking[]            @relation("TechnicianBookings")
  reviews    Review[]

  @@index([areaId])
  @@index([online])
  @@index([verified])
  @@index([ratingAvg])
  @@index([visitFee])
  @@map("technician_profiles")
}

model TechnicianCategory {
  technicianId String
  categoryId   String

  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([technicianId, categoryId])
  @@index([categoryId])
  @@map("technician_categories")
}

model TechnicianSkill {
  id           String @id @default(cuid())
  technicianId String
  name         String

  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, name])
  @@index([technicianId])
  @@map("technician_skills")
}

model AvailabilitySlot {
  id           String   @id @default(cuid())
  technicianId String
  date         DateTime @db.Date
  startTime    String // "08:00 AM"
  endTime      String?
  isBooked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  booking    Booking?

  @@unique([technicianId, date, startTime])
  @@index([technicianId, date])
  @@index([isBooked])
  @@map("availability_slots")
}

// ─────────────────────────────────────────────
// Bookings & payments
// ─────────────────────────────────────────────

model Booking {
  id           String        @id @default(cuid())
  refCode      String        @unique // FIX-4830
  customerId   String
  technicianId String
  serviceId    String
  slotId       String?       @unique
  status       BookingStatus @default(REQUESTED)

  // Price snapshot (৳) at request time
  scheduledAt  DateTime?
  slotLabel    String? // "Wed 29 Jul · 10 AM"
  servicePrice Int
  visitFee     Int
  totalAmount  Int
  notes        String?

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  declinedAt  DateTime?
  paidAt      DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer   User              @relation("CustomerBookings", fields: [customerId], references: [id])
  technician TechnicianProfile @relation("TechnicianBookings", fields: [technicianId], references: [id])
  service    Service           @relation(fields: [serviceId], references: [id])
  slot       AvailabilitySlot? @relation(fields: [slotId], references: [id])
  payment    Payment?
  review     Review?

  @@index([customerId])
  @@index([technicianId])
  @@index([serviceId])
  @@index([status])
  @@index([requestedAt])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  userId        String
  amount        Int // ৳
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  providerTxnId String?
  paidAt        DateTime?
  failedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  authorId       String?
  authorName     String
  authorInitials String
  rating         Int // 1–5
  body           String
  target         ReviewTarget
  serviceId      String?
  technicianId   String?
  bookingId      String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  author     User?              @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  service    Service?           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  technician TechnicianProfile? @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  booking    Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@index([technicianId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}
